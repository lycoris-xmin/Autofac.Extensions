<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>Autofac特性自动注册</Title>
		<Authors>Lycoris</Authors>
		<Description>Autofac封装扩展，支持特性自动注册，也支持手动注册，兼容原生Module</Description>
		<PackageIcon>
		</PackageIcon>
		<VersionPrefix>10.0.0</VersionPrefix>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageProjectUrl>https://github.com/lycoris-xmin/Autofac.Extensions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lycoris-xmin/Autofac.Extensions</RepositoryUrl>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<None Include="..\Readme.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<PackageReference Include="Autofac" Version="9.3.1" />
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
		<PackageReference Include="Autofac.Extras.DynamicProxy" Version="8.0.1" />
		<PackageReference Include="Castle.Core.AsyncInterceptor" Version="2.1.0" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Readme.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>